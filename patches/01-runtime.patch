+    webviewLoading = true
+    let disposed = false
+    let guestId: number | undefined
+    const listeners: [string, (event: Event) => void][] = []
+    const listen = <E extends Event>(name: string, callback: (event: E) => void): void => {
+      const listener = callback as (event: Event) => void
