+  $effect(() => {
+    startupLine = ''
+    if (!isLoading || connectionId !== 'local') return undefined
+    return window.electronAPI.onTerminalLine('server', (line: string) => {
+      startupLine = line
+    })
+  })
+
+  export const refresh = (): void => {
+    if (!canRefresh || !webview) return
