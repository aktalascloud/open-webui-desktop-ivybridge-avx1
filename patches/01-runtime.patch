+    } catch (e) {
+      operationError = e instanceof Error ? e.message : String(e)
+    }
+    restarting = false
+  }
+
+  const updatePackage = async () => {
+    if (busy) return
+    updating = true
+    operationError = ''
+    try {
+      otInfo = await window.electronAPI.updateOpenTerminal()
