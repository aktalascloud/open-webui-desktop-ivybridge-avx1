diff --git a/.avx1/voice-input-ipc.test.mjs b/.avx1/voice-input-ipc.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..243e3a8de5072f5909097a31afd8ba349a60a693
--- /dev/null
+++ b/.avx1/voice-input-ipc.test.mjs
@@ -0,0 +1,130 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { readFileSync } from 'node:fs'
+import { stripTypeScriptTypes } from 'node:module'
+import ts from 'typescript'
+import { VoiceInputSessions, isOwnedVoiceGuest } from '../src/main/voice-input-session.ts'
+
+const source = readFileSync(new URL('../src/main/index.ts', import.meta.url), 'utf8')
+const tree = ts.createSourceFile('index.ts', source, ts.ScriptTarget.Latest, true)
+const callbacks = new Map()
+let requireCaller
+function visit(node) {
+  if (ts.isFunctionDeclaration(node) && node.name?.text === 'requireVoiceCaller') requireCaller = node.getText(tree)
+  if (ts.isCallExpression(node) && node.expression.getText(tree) === 'ipcMain.handle' &&
+      ts.isStringLiteral(node.arguments[0])) callbacks.set(node.arguments[0].text, node.arguments[1].getText(tree))
+  ts.forEachChild(node, visit)
+}
+visit(tree)
+assert.ok(requireCaller)
+
+function fixture() {
+  const voice = { mainFrame: {}, getURL: () => 'file:///app/voice-input.html' }
+  const target = { connectionId: 'local', url: 'http://127.0.0.1:8080', guestId: 7 }
+  let current = { ...target }, token = 'synthetic-A'
+  const posts = [], events = []
+  const sessions = new VoiceInputSessions(async () => token)
+  const runtime = {
+    voiceSessions: sessions,
+    voiceInputWindow: { webContents: voice, hide() {} },
+    voiceInputRecording: true,
+    nativeVoiceURL: () => 'file:///app/voice-input.html',
+    currentVoiceTarget: async () => ({ ...current }),
+    fetch: async (url, options) => {
+      posts.push({ url, options })
+      return { ok: true, json: async () => ({ text: 'server transcript' }) }
+    },
+    Buffer,
+    Notification: class { show() {} }, nativeText: value => value,
+    log: { error() {} }, playChime() {}, showMainWindow() {},
+    sendToRenderer: (type, data) => events.push({ type, data })
+  }
+  runtime.requireVoiceCaller = new Function('runtime', `with (runtime) { ${stripTypeScriptTypes(requireCaller)}; return requireVoiceCaller }`)(runtime)
+  function callback(name) {
+    const body = callbacks.get(name)
+    assert.ok(body, name)
+    return new Function('runtime', `with (runtime) { return (${stripTypeScriptTypes(body)}) }`)(runtime)
+  }
+  return { runtime, sessions, posts, events, target,
+    event: { sender: voice, senderFrame: voice.mainFrame }, callback,
+    select: value => { current = { ...target, ...value } },
+    token: value => { token = value } }
+}
+
+test('real IPC posts once to the captured target and delivers only the server result', async () => {
+  const f = fixture()
+  const id = await f.sessions.begin(f.target)
+  const result = await f.callback('voiceInput:transcribe')(f.event, id, new ArrayBuffer(16))
+  assert.deepEqual(result, { text: 'server transcript' })
+  assert.equal(f.posts.length, 1)
+  assert.equal(f.posts[0].url, 'http://127.0.0.1:8080/api/v1/audio/transcriptions')
+  assert.equal(f.posts[0].options.redirect, 'error')
+  assert.equal(f.posts[0].options.headers.Authorization, 'Bearer synthetic-A')
+  await f.callback('voiceInput:done')(f.event, id, 'renderer-forged transcript')
+  assert.deepEqual(f.events, [{ type: 'query', data: { query: 'server transcript', connectionId: 'local', url: f.target.url } }])
+  await assert.rejects(f.callback('voiceInput:transcribe')(f.event, id, new ArrayBuffer(16)))
+  assert.equal(f.posts.length, 1)
+})
+
+test('real IPC rejects other frames and invalid buffers before any network call', async () => {
+  const f = fixture()
+  const id = await f.sessions.begin(f.target)
+  await assert.rejects(f.callback('voiceInput:transcribe')({ ...f.event, senderFrame: {} }, id, new ArrayBuffer(16)), /caller/)
+  await assert.rejects(f.callback('voiceInput:transcribe')(f.event, id, { byteLength: 16 }), /buffer/)
+  assert.equal(f.posts.length, 0)
+  assert.equal(f.sessions.id, id)
+})
+
+test('connection selection changes prevent upload and transcript delivery to the new account', async () => {
+  const f = fixture()
+  let id = await f.sessions.begin(f.target)
+  f.select({ connectionId: 'remote', url: 'https://other.invalid', guestId: 8 })
+  await assert.rejects(f.callback('voiceInput:transcribe')(f.event, id, new ArrayBuffer(16)), /connection changed/)
+  assert.equal(f.posts.length, 0)
+  f.select({})
+  id = await f.sessions.begin(f.target)
+  await f.callback('voiceInput:transcribe')(f.event, id, new ArrayBuffer(16))
+  f.select({ connectionId: 'remote', url: 'https://other.invalid', guestId: 8 })
+  await assert.rejects(f.callback('voiceInput:done')(f.event, id), /connection changed/)
+  assert.deepEqual(f.events, [])
+})
+
+test('uncertain transport failure cannot be submitted again and stale close cannot cancel a newer recording', async () => {
+  const f = fixture()
+  f.runtime.fetch = async () => { f.posts.push('uncertain'); throw Error('synthetic transport failure') }
+  const first = await f.sessions.begin(f.target)
+  await assert.rejects(f.callback('voiceInput:transcribe')(f.event, first, new ArrayBuffer(16)))
+  await assert.rejects(f.callback('voiceInput:transcribe')(f.event, first, new ArrayBuffer(16)))
+  assert.equal(f.posts.length, 1)
+  const second = await f.sessions.begin(f.target)
+  f.callback('voiceInput:close')(f.event, first)
+  assert.equal(f.sessions.id, second)
+})
+
+test('guest registry accepts only configured guests owned by the trusted main frame and its partition', async () => {
+  const f = fixture()
+  const owner = { mainFrame: {} }, partition = {}, other = {}
+  const guest = { id: 7, hostWebContents: owner, session: partition,
+    getType: () => 'webview', isDestroyed: () => false, getURL: () => f.target.url }
+  Object.assign(f.runtime, {
+    mainWindow: { webContents: owner }, voiceGuests: new Map(),
+    getConfig: async () => ({ connections: [] }),
+    buildLocalConnection: () => ({ id: 'local', url: f.target.url }),
+    resolveConnectionUrl: connection => connection.url,
+    webContents: { fromId: id => id === 7 ? guest : undefined },
+    session: { fromPartition: value => value === 'persist:connection-local' ? partition : other },
+    isOwnedVoiceGuest
+  })
+  const event = { sender: owner, senderFrame: owner.mainFrame }
+  const register = f.callback('connection:guest')
+  await assert.rejects(register({ ...event, senderFrame: {} }, 'local', 7), /registration/)
+  await assert.rejects(register(event, 'unknown', 7), /Unknown connection/)
+  await register(event, 'local', 7)
+  assert.equal(f.runtime.voiceGuests.get('local'), 7)
+  guest.session = other
+  await assert.rejects(register(event, 'local', 7), /Invalid connection guest/)
+  f.callback('connection:guest:remove')(event, 'local', 8)
+  assert.equal(f.runtime.voiceGuests.get('local'), 7)
+  f.callback('connection:guest:remove')(event, 'local', 7)
+  assert.equal(f.runtime.voiceGuests.size, 0)
+})
diff --git a/.avx1/voice-input-recorder.test.mjs b/.avx1/voice-input-recorder.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0d71e1a8ce8195d349384d6697c72d0b2476549c
--- /dev/null
+++ b/.avx1/voice-input-recorder.test.mjs
@@ -0,0 +1,80 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { readFileSync } from 'node:fs'
+import { stripTypeScriptTypes } from 'node:module'
+
+const component = readFileSync(new URL('../src/renderer/src/components/VoiceInput.svelte', import.meta.url), 'utf8')
+const script = stripTypeScriptTypes(component.slice(component.indexOf('>') + 1, component.indexOf('</script>'))
+  .replace(/^\s*import .* from 'svelte'\s*$/m, ''))
+
+function stream() {
+  let stopped = 0
+  return { getTracks: () => [{ stop: () => stopped++ }], stopped: () => stopped }
+}
+function fixture(getUserMedia) {
+  const calls = [], recorders = []
+  let interval
+  const api = { checkMicPermission: async () => 'granted',
+    transcribe: async id => { calls.push(['transcribe', id]); return { text: 'synthetic' } },
+    done: async id => { calls.push(['done', id]) }, close: async id => { calls.push(['close', id]) },
+    error: (...args) => calls.push(['error', ...args]), onRecordingState() {} }
+  class Recorder {
+    static isTypeSupported() { return true }
+    constructor(input, options) { this.stream = input; this.mimeType = options.mimeType; this.state = 'inactive'; recorders.push(this) }
+    start() { this.state = 'recording' }
+    stop() { this.state = 'inactive'; this.onstop?.() }
+    emit() { this.ondataavailable({ data: new Blob([new Uint8Array(8192)]) }) }
+  }
+  class Context {
+    createAnalyser() { return { frequencyBinCount: 2, getByteFrequencyData() {} } }
+    createMediaStreamSource() { return { connect() {} } }
+    close() { return Promise.resolve() }
+  }
+  const run = new Function('window', 'navigator', '$state', 'onMount', 'onDestroy', 'MediaRecorder',
+    'AudioContext', 'requestAnimationFrame', 'cancelAnimationFrame', 'setTimeout', 'clearTimeout', 'setInterval', 'clearInterval', `
+    ${script}; return {startRecording, stopRecording, cancelRecording, state: () => ({sessionId, recording, transcribing})};
+  `)({ voiceInputAPI: api }, { mediaDevices: { getUserMedia } }, value => value, () => {}, () => {}, Recorder,
+    Context, () => 1, () => {}, callback => { callback(); return 1 }, () => {},
+    callback => { interval = callback; return 1 }, () => { interval = undefined })
+  return { ...run, api, calls, recorders, tick: () => interval?.() }
+}
+
+test('cancel before delayed microphone grant stops the acquired stream without creating a recorder', async () => {
+  let grant
+  const audio = stream()
+  const f = fixture(() => new Promise(resolve => { grant = resolve }))
+  const pending = f.startRecording(1)
+  for (let i = 0; i < 5; i++) await Promise.resolve()
+  assert.equal(typeof grant, 'function')
+  f.cancelRecording()
+  grant(audio)
+  await pending
+  assert.equal(audio.stopped(), 1)
+  assert.equal(f.recorders.length, 0)
+  assert.deepEqual(f.calls, [['close', 1]])
+})
+
+test('late transcription cannot deliver text or close a newer recording', async () => {
+  const firstAudio = stream(), secondAudio = stream()
+  let captures = 0, finish, submitted
+  const submission = new Promise(resolve => { submitted = resolve })
+  const f = fixture(async () => ++captures === 1 ? firstAudio : secondAudio)
+  f.api.transcribe = async id => {
+    f.calls.push(['transcribe', id])
+    submitted()
+    return new Promise(resolve => { finish = resolve })
+  }
+  await f.startRecording(1)
+  f.recorders[0].emit()
+  f.tick()
+  const pending = f.stopRecording()
+  await submission
+  await f.startRecording(2)
+  finish({ text: 'late private transcript' })
+  await pending
+  assert.deepEqual(f.calls, [['transcribe', 1]])
+  assert.equal(f.state().sessionId, 2)
+  assert.equal(f.state().recording, true)
+  assert.ok(firstAudio.stopped() > 0)
+  assert.equal(secondAudio.stopped(), 0)
+})
diff --git a/.avx1/voice-input-session.test.mjs b/.avx1/voice-input-session.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..052079ca80e1783299de26b914e1b06079274111
--- /dev/null
+++ b/.avx1/voice-input-session.test.mjs
@@ -0,0 +1,113 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { VoiceInputSessions, readOwnedVoiceToken, isOwnedVoiceGuest } from '../src/main/voice-input-session.ts'
+
+const target = { connectionId: 'local', url: 'http://127.0.0.1:8080', guestId: 7 }
+function guestFixture() {
+  const host = {}, partition = {}
+  let url = target.url, token = 'synthetic-A', reads = 0
+  const guest = { id: 7, isDestroyed: () => false, getType: () => 'webview', getURL: () => url,
+    hostWebContents: host, session: partition,
+    executeJavaScript: async source => {
+      assert.equal(source, "localStorage.getItem('token') || ''")
+      reads++
+      return token
+    } }
+  return { guest, host, partition, navigate: value => { url = value }, token: value => { token = value }, reads: () => reads }
+}
+
+test('only the exact owned guest, partition and origin can supply the token', async () => {
+  const f = guestFixture()
+  assert.equal(await readOwnedVoiceToken(f.guest, target, f.host, f.partition), 'synthetic-A')
+  for (const overrides of [{ id: 8 }, { hostWebContents: {} }, { session: {} }, { getType: () => 'window' },
+    { isDestroyed: () => true }, { getURL: () => 'https://other.invalid' }]) {
+    assert.equal(isOwnedVoiceGuest({ ...f.guest, ...overrides }, target, f.host, f.partition), false)
+  }
+  assert.equal(isOwnedVoiceGuest(f.guest, { ...target, url: 'http://user:password@127.0.0.1:8080' }, f.host, f.partition), false)
+  assert.equal(f.reads(), 1)
+})
+
+test('redirect while reading storage rejects the result', async () => {
+  const f = guestFixture()
+  f.guest.executeJavaScript = async () => { f.navigate('https://other.invalid'); return 'synthetic-A' }
+  await assert.rejects(readOwnedVoiceToken(f.guest, target, f.host, f.partition), /changed/)
+})
+
+test('empty or malformed current token never falls back to another browser context', async () => {
+  const f = guestFixture()
+  for (const value of ['', null, { token: 'synthetic' }, 'x'.repeat(16385)]) {
+    f.token(value)
+    await assert.rejects(readOwnedVoiceToken(f.guest, target, f.host, f.partition), /Not authenticated/)
+  }
+  assert.equal(f.reads(), 4)
+})
+
+test('one captured account gets one submission and one server-result delivery', async () => {
+  const sessions = new VoiceInputSessions(async () => 'synthetic-A')
+  const id = await sessions.begin(target)
+  const claim = await sessions.claim(id, target)
+  assert.equal(claim.url, target.url)
+  assert.equal(claim.token, 'synthetic-A')
+  await assert.rejects(sessions.claim(id, target), /already submitted/)
+  sessions.finish(id, '  transcript  ')
+  assert.deepEqual(await sessions.deliver(id, target), { target, text: 'transcript' })
+  assert.equal(claim.signal.aborted, true)
+  await assert.rejects(sessions.deliver(id, target), /changed/)
+})
+
+test('changed connection, guest or base path rejects before upload', async () => {
+  for (const change of [{ connectionId: 'remote' }, { guestId: 8 }, { url: target.url + '/other' }]) {
+    const sessions = new VoiceInputSessions(async () => 'synthetic-A')
+    const id = await sessions.begin(target)
+    await assert.rejects(sessions.claim(id, { ...target, ...change }), /connection changed/)
+  }
+})
+
+test('switching the signed-in account rejects both upload and later delivery', async () => {
+  let token = 'synthetic-A'
+  const sessions = new VoiceInputSessions(async () => token)
+  let id = await sessions.begin(target)
+  token = 'synthetic-B'
+  await assert.rejects(sessions.claim(id, target), /account changed/)
+  token = 'synthetic-A'
+  id = await sessions.begin(target)
+  await sessions.claim(id, target)
+  sessions.finish(id, 'private transcript')
+  token = 'synthetic-B'
+  await assert.rejects(sessions.deliver(id, target), /account changed/)
+})
+
+test('a superseded recording aborts its request and stale completion cannot affect the new recording', async () => {
+  const sessions = new VoiceInputSessions(async () => 'synthetic-A')
+  const first = await sessions.begin(target)
+  const claim = await sessions.claim(first, target)
+  const second = await sessions.begin(target)
+  assert.equal(claim.signal.aborted, true)
+  assert.throws(() => sessions.finish(first, 'late'), /expired/)
+  sessions.cancel(first)
+  assert.equal(sessions.id, second)
+  assert.equal((await sessions.claim(second, target)).signal.aborted, false)
+})
+
+test('simultaneous transcription claims reserve before awaiting token lookup', async () => {
+  let reads = 0, finish
+  const sessions = new VoiceInputSessions(async () => {
+    if (++reads === 1) return 'synthetic-A'
+    return new Promise(resolve => { finish = resolve })
+  })
+  const id = await sessions.begin(target)
+  const pending = sessions.claim(id, target)
+  await assert.rejects(sessions.claim(id, target), /already submitted/)
+  finish('synthetic-A')
+  await pending
+})
+
+test('cancel during token lookup invalidates a pending recording start', async () => {
+  let finish
+  const sessions = new VoiceInputSessions(() => new Promise(resolve => { finish = resolve }))
+  const pending = sessions.begin(target)
+  sessions.cancel()
+  finish('synthetic-A')
+  await assert.rejects(pending, /superseded/)
+  assert.equal(sessions.id, undefined)
+})
