index 0000000000000000000000000000000000000000..905fde61077250d4e92eb17fc7c8e10b63b56f6d
--- /dev/null
+++ b/.github/workflows/avx1-build.yml
@@ -0,0 +1,68 @@
+name: AVX1 verified candidates
+on:
+  workflow_dispatch:
+    inputs:
+      day:
+        description: Build date YYYYMMDD
+        required: true
+        type: string
+permissions:
+  contents: read
+  actions: read
+concurrency:
+  group: avx1-candidates
+  cancel-in-progress: false
+jobs:
+  build:
+    runs-on: windows-2022
+    timeout-minutes: 180
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
+        with:
+          ref: ${{ github.sha }}
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12'
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020
+        with:
+          node-version: '22'
+
+      - uses: actions/cache/restore@0057852bfaa89a56745cba8c7296529d2fc39830
+        with:
+          path: .avx1-native-cache
+          key: node-cache-ivy-${{ hashFiles('.avx1/desktop-native-reference.json') }}
+      - name: Build, test, audit and package
+        env:
+          BUILD_CHANNEL: latest
+          BUILD_DAY: ${{ inputs.day }}
+          GITHUB_TOKEN: ${{ github.token }}
+
+        run: python .avx1/build.py
+      - uses: actions/cache/save@0057852bfaa89a56745cba8c7296529d2fc39830
+        if: always() && hashFiles('.avx1-native-cache/reference-complete.json') != ''
+        with:
+          path: .avx1-native-cache
+          key: node-cache-ivy-${{ hashFiles('.avx1/desktop-native-reference.json') }}
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: candidate-latest
+          path: .avx1-out/*
+          if-no-files-found: error
+          retention-days: 7
+          include-hidden-files: true
+      - name: Upload safe diagnostics
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: diagnostics-latest
+          path: |
+            .avx1-work/pip-audit.json
+            .avx1-work/security-gate.json
+            .avx1-work/desktop-test-profile/russian-failure.png
+            .avx1-work/desktop-test-profile/renderer-state.json
+            .avx1-work/desktop-test-profile-production/launch-failure.txt
+            .avx1-work/desktop-test-profile-production/russian-onboarding.png
+          if-no-files-found: ignore
+          include-hidden-files: true
+          retention-days: 3
