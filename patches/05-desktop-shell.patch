+            {/if}
+          </div>
+
+          <div class="mt-6">
+            <button
+              class="text-sm opacity-40 hover:opacity-70 transition bg-transparent border-none text-[#1d1d1f] dark:text-[#fafafa]"
+              onclick={() => (view = 'install')}
+            >
