+
+test('packaged smoke refuses weakened shipping fuses', () => {
+  const fuses = {}
+  for (const key of ['EnableNodeOptionsEnvironmentVariable', 'EnableNodeCliInspectArguments']) fuses[FuseV1Options[key]] = FuseState.DISABLE
